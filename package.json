{
  "name": "@fulldecent/nice-checkers-plugin",
  "version": "1.3.11",
  "description": "HTML-validate plugin and rules you should always use",
  "author": "William Entriken",
  "license": "MIT",
  "homepage": "https://github.com/fulldecent/html-validate-nice-checkers/#readme",
  "bugs": {
    "url": "https://github.com/fulldecent/html-validate-nice-checkers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fulldecent/html-validate-nice-checkers.git"
  },
  "keywords": [
    "html-validate",
    "html",
    "validation",
    "rules",
    "plugin",
    "linting"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "--": "format uses npx @latest so it matches .github/workflows/lint.yml. A pinned devDependency would let the local write and the CI check disagree.",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "check:package": "publint && attw --pack .",
    "format": "npx prettier@latest --write . && npx markdownlint-cli@latest --fix '**/*.md' --ignore node_modules",
    "clean": "rimraf dist",
    "prepublishOnly": "yarn clean && npx prettier@latest --check . && npx markdownlint-cli@latest '**/*.md' --ignore node_modules && yarn lint && yarn test && yarn build && yarn check:package",
    "dev": "yarn build:watch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jaredwray/mockhttp": "^2.0.0",
    "@types/node": "^26.6.3",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^5.0.2",
    "html-validate": "^11.16.1",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "structured-data-testing-tool": "^4.5.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "html-validate": "^10.0.0 || ^11.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}